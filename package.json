```react
import React, { useState, useEffect, useMemo } from 'react';
import { initializeApp } from 'firebase/app';
import { 
  getFirestore, 
  collection, 
  doc, 
  addDoc, 
  onSnapshot, 
  query, 
  updateDoc, 
  deleteDoc, 
  setDoc
} from 'firebase/firestore';
import { 
  getAuth, 
  signInAnonymously, 
  signInWithCustomToken, 
  onAuthStateChanged 
} from 'firebase/auth';
import { 
  Calendar, 
  Plus, 
  DollarSign, 
  User, 
  Clock, 
  Trash2, 
  CheckCircle, 
  TrendingUp, 
  Users,
  Calendar as CalendarIcon,
  ChevronRight,
  LogOut
} from 'lucide-react';

// --- Firebase Configuration ---
const firebaseConfig = JSON.parse(__firebase_config);
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const appId = typeof __app_id !== 'undefined' ? __app_id : 'nail-salon-app-001';

const App = () => {
  const [user, setUser] = useState(null);
  const [activeTab, setActiveTab] = useState('appointments');
  const [appointments, setAppointments] = useState([]);
  const [earnings, setEarnings] = useState([]);
  const [loading, setLoading] = useState(true);

  // Form states
  const [showAppointmentModal, setShowAppointmentModal] = useState(false);
  const [showEarningModal, setShowEarningModal] = useState(false);

  // Constants
  const COMMISSION_RATE = 0.6; // Ví dụ: Nhân viên hưởng 60%

  // --- Auth Setup ---
  useEffect(() => {
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (err) {
        console.error("Auth error:", err);
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(auth, (u) => {
      setUser(u);
      setLoading(false);
    });
    return () => unsubscribe();
  }, []);

  // --- Firestore Data Subscriptions ---
  useEffect(() => {
    if (!user) return;

    // Listen to appointments
    const qAppts = collection(db, 'artifacts', appId, 'public', 'data', 'appointments');
    const unsubAppts = onSnapshot(qAppts, (snapshot) => {
      const data = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      setAppointments(data.sort((a, b) => new Date(a.time) - new Date(b.time)));
    }, (err) => console.error("Firestore appts error:", err));

    // Listen to earnings (private to user)
    const qEarnings = collection(db, 'artifacts', appId, 'users', user.uid, 'earnings');
    const unsubEarnings = onSnapshot(qEarnings, (snapshot) => {
      const data = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      setEarnings(data.sort((a, b) => new Date(b.date) - new Date(a.date)));
    }, (err) => console.error("Firestore earnings error:", err));

    return () => {
      unsubAppts();
      unsubEarnings();
    };
  }, [user]);

  // --- Handlers ---
  const addAppointment = async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const newAppt = {
      clientName: formData.get('clientName'),
      service: formData.get('service'),
      time: formData.get('time'),
      status: 'pending',
      createdAt: new Date().toISOString()
    };
    await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'appointments'), newAppt);
    setShowAppointmentModal(false);
  };

  const addEarning = async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const amount = parseFloat(formData.get('amount'));
    const newEntry = {
      serviceName: formData.get('serviceName'),
      totalAmount: amount,
      commission: amount * COMMISSION_RATE,
      date: new Date().toISOString(),
      staffId: user.uid,
      staffName: user.displayName || 'Nhân viên'
    };
    await addDoc(collection(db, 'artifacts', appId, 'users', user.uid, 'earnings'), newEntry);
    setShowEarningModal(false);
  };

  const deleteAppointment = async (id) => {
    await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'appointments', id));
  };

  const completeAppointment = async (appt) => {
    // Update status
    await updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'appointments', appt.id), {
      status: 'completed'
    });
    // Optional: Auto-add to earnings if price is known
  };

  // --- Calculations ---
  const stats = useMemo(() => {
    const totalRevenue = earnings.reduce((sum, item) => sum + item.totalAmount, 0);
    const totalCommission = earnings.reduce((sum, item) => sum + item.commission, 0);
    const pendingAppts = appointments.filter(a => a.status === 'pending').length;
    return { totalRevenue, totalCommission, pendingAppts };
  }, [earnings, appointments]);

  if (loading) {
    return (
      <div className="flex items-center justify-center min-h-screen bg-slate-50">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-pink-500"></div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-slate-50 pb-20 font-sans text-slate-900">
      {/* Header */}
      <header className="bg-white border-b border-slate-200 sticky top-0 z-10 p-4 flex justify-between items-center shadow-sm">
        <div>
          <h1 className="text-xl font-bold bg-gradient-to-r from-pink-500 to-rose-500 bg-clip-text text-transparent">
            Nail Salon Manager
          </h1>
          <p className="text-xs text-slate-400">ID Nhân viên: {user?.uid?.slice(0, 8)}</p>
        </div>
        <div className="flex items-center gap-3">
          <div className="bg-pink-100 p-2 rounded-full">
            <User size={20} className="text-pink-600" />
          </div>
        </div>
      </header>

      {/* Main Content */}
      <main className="max-w-4xl mx-auto p-4 space-y-6">
        
        {/* Stats Cards */}
        <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
          <div className="bg-white p-4 rounded-2xl shadow-sm border border-slate-100 flex flex-col items-center text-center">
            <div className="bg-green-100 p-2 rounded-xl mb-2">
              <TrendingUp size={20} className="text-green-600" />
            </div>
            <span className="text-xs text-slate-500 font-medium">Tổng thu nhập</span>
            <span className="text-lg font-bold">${stats.totalCommission.toLocaleString()}</span>
          </div>
          <div className="bg-white p-4 rounded-2xl shadow-sm border border-slate-100 flex flex-col items-center text-center">
            <div className="bg-blue-100 p-2 rounded-xl mb-2">
              <CalendarIcon size={20} className="text-blue-600" />
            </div>
            <span className="text-xs text-slate-500 font-medium">Lịch hẹn mới</span>
            <span className="text-lg font-bold">{stats.pendingAppts}</span>
          </div>
          <div className="hidden md:flex bg-white p-4 rounded-2xl shadow-sm border border-slate-100 flex-col items-center text-center">
            <div className="bg-purple-100 p-2 rounded-xl mb-2">
              <Users size={20} className="text-purple-600" />
            </div>
            <span className="text-xs text-slate-500 font-medium">Hoa hồng (60%)</span>
            <span className="text-lg font-bold">${(stats.totalRevenue * 0.6).toLocaleString()}</span>
          </div>
        </div>

        {/* Tab Navigation */}
        <div className="flex bg-slate-200/50 p-1 rounded-xl">
          <button 
            onClick={() => setActiveTab('appointments')}
            className={`flex-1 flex items-center justify-center gap-2 py-2.5 rounded-lg transition-all ${activeTab === 'appointments' ? 'bg-white shadow-sm font-bold text-pink-600' : 'text-slate-500'}`}
          >
            <Clock size={18} /> <span>Lịch hẹn</span>
          </button>
          <button 
            onClick={() => setActiveTab('earnings')}
            className={`flex-1 flex items-center justify-center gap-2 py-2.5 rounded-lg transition-all ${activeTab === 'earnings' ? 'bg-white shadow-sm font-bold text-pink-600' : 'text-slate-500'}`}
          >
            <DollarSign size={18} /> <span>Thu nhập</span>
          </button>
        </div>

        {/* Tab Content: Appointments */}
        {activeTab === 'appointments' && (
          <div className="space-y-4">
            <div className="flex justify-between items-center px-1">
              <h2 className="font-bold text-lg">Hôm nay</h2>
              <button 
                onClick={() => setShowAppointmentModal(true)}
                className="bg-pink-500 text-white p-2 rounded-xl shadow-lg shadow-pink-200 active:scale-95 transition-transform"
              >
                <Plus size={20} />
              </button>
            </div>

            {appointments.length === 0 ? (
              <div className="text-center py-12 bg-white rounded-3xl border-2 border-dashed border-slate-200">
                <CalendarIcon className="mx-auto text-slate-300 mb-2" size={48} />
                <p className="text-slate-400 text-sm">Chưa có lịch hẹn nào</p>
              </div>
            ) : (
              <div className="space-y-3">
                {appointments.map(appt => (
                  <div key={appt.id} className={`bg-white p-4 rounded-2xl shadow-sm border-l-4 ${appt.status === 'completed' ? 'border-green-400 opacity-60' : 'border-pink-400'}`}>
                    <div className="flex justify-between items-start">
                      <div>
                        <h3 className="font-bold text-slate-800">{appt.clientName}</h3>
                        <p className="text-sm text-slate-500">{appt.service}</p>
                        <div className="flex items-center gap-2 mt-2 text-xs text-slate-400 bg-slate-50 px-2 py-1 rounded-full w-fit">
                          <Clock size={14} />
                          {new Date(appt.time).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' })}
                        </div>
                      </div>
                      <div className="flex gap-2">
                        {appt.status !== 'completed' && (
                          <button 
                            onClick={() => completeAppointment(appt)}
                            className="p-2 text-green-600 bg-green-50 rounded-lg"
                          >
                            <CheckCircle size={18} />
                          </button>
                        )}
                        <button 
                          onClick={() => deleteAppointment(appt.id)}
                          className="p-2 text-rose-600 bg-rose-50 rounded-lg"
                        >
                          <Trash2 size={18} />
                        </button>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}

        {/* Tab Content: Earnings */}
        {activeTab === 'earnings' && (
          <div className="space-y-4">
            <div className="flex justify-between items-center px-1">
              <h2 className="font-bold text-lg">Bảng lương cá nhân</h2>
              <button 
                onClick={() => setShowEarningModal(true)}
                className="bg-green-500 text-white p-2 rounded-xl shadow-lg shadow-green-200 active:scale-95 transition-transform"
              >
                <Plus size={20} />
              </button>
            </div>

            {earnings.length === 0 ? (
              <div className="text-center py-12 bg-white rounded-3xl border-2 border-dashed border-slate-200">
                <DollarSign className="mx-auto text-slate-300 mb-2" size={48} />
                <p className="text-slate-400 text-sm">Bạn chưa ghi thu nhập nào hôm nay</p>
              </div>
            ) : (
              <div className="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                <div className="divide-y divide-slate-100">
                  {earnings.map(earn => (
                    <div key={earn.id} className="p-4 flex justify-between items-center">
                      <div>
                        <p className="font-bold text-slate-800">{earn.serviceName}</p>
                        <p className="text-xs text-slate-400">
                          {new Date(earn.date).toLocaleDateString('vi-VN')} • Hoa hồng: ${earn.commission.toLocaleString()}
                        </p>
                      </div>
                      <div className="text-right">
                        <span className="text-lg font-bold text-green-600">+${earn.totalAmount.toLocaleString()}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}
      </main>

      {/* Appointment Modal */}
      {showAppointmentModal && (
        <div className="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-end md:items-center justify-center p-0 md:p-4">
          <div className="bg-white w-full max-w-md rounded-t-3xl md:rounded-3xl p-6 space-y-4 animate-in slide-in-from-bottom duration-300">
            <div className="flex justify-between items-center">
              <h3 className="text-xl font-bold">Đặt lịch mới</h3>
              <button onClick={() => setShowAppointmentModal(false)} className="text-slate-400">✕</button>
            </div>
            <form onSubmit={addAppointment} className="space-y-4">
              <div className="space-y-2">
                <label className="text-sm font-medium text-slate-700">Tên khách hàng</label>
                <input required name="clientName" className="w-full bg-slate-50 border-0 rounded-xl p-3 focus:ring-2 focus:ring-pink-500" placeholder="Nhập tên khách..." />
              </div>
              <div className="space-y-2">
                <label className="text-sm font-medium text-slate-700">Dịch vụ</label>
                <select name="service" className="w-full bg-slate-50 border-0 rounded-xl p-3 focus:ring-2 focus:ring-pink-500">
                  <option>Cắt da & Sơn gel</option>
                  <option>Nối mi</option>
                  <option>Đắp bột</option>
                  <option>Chà gót chân</option>
                </select>
              </div>
              <div className="space-y-2">
                <label className="text-sm font-medium text-slate-700">Thời gian</label>
                <input required type="datetime-local" name="time" className="w-full bg-slate-50 border-0 rounded-xl p-3 focus:ring-2 focus:ring-pink-500" />
              </div>
              <button type="submit" className="w-full bg-pink-500 text-white font-bold py-4 rounded-2xl shadow-lg shadow-pink-100">
                Lưu lịch hẹn
              </button>
            </form>
          </div>
        </div>
      )}

      {/* Earning Modal */}
      {showEarningModal && (
        <div className="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-end md:items-center justify-center p-0 md:p-4">
          <div className="bg-white w-full max-w-md rounded-t-3xl md:rounded-3xl p-6 space-y-4 animate-in slide-in-from-bottom duration-300">
            <div className="flex justify-between items-center">
              <h3 className="text-xl font-bold">Ghi thu nhập</h3>
              <button onClick={() => setShowEarningModal(false)} className="text-slate-400">✕</button>
            </div>
            <form onSubmit={addEarning} className="space-y-4">
              <div className="space-y-2">
                <label className="text-sm font-medium text-slate-700">Tên dịch vụ đã làm</label>
                <input required name="serviceName" className="w-full bg-slate-50 border-0 rounded-xl p-3 focus:ring-2 focus:ring-green-500" placeholder="Ví dụ: Đắp bột Ombre" />
              </div>
              <div className="space-y-2">
                <label className="text-sm font-medium text-slate-700">Tổng tiền khách trả ($)</label>
                <input required type="number" name="amount" className="w-full bg-slate-50 border-0 rounded-xl p-3 focus:ring-2 focus:ring-green-500" placeholder="50" />
              </div>
              <div className="p-4 bg-green-50 rounded-xl border border-green-100">
                <p className="text-xs text-green-600 font-medium">Phần trăm của bạn: 60%</p>
                <p className="text-sm text-slate-500 italic mt-1">* Lương của bạn sẽ được tự động cộng dồn.</p>
              </div>
              <button type="submit" className="w-full bg-green-600 text-white font-bold py-4 rounded-2xl shadow-lg shadow-green-100">
                Xác nhận hoàn tất
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  );
};

export default App;
```